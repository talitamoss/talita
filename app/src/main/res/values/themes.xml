<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Talita" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#6366F1</item>
        <item name="colorPrimaryVariant">#4C4EDB</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">#EC4899</item>
        <item name="colorSecondaryVariant">#DB2777</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">#0A0A0A</item>
        <item name="colorSurface">#1A1A1A</item>
        <item name="colorError">#EF4444</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">#0A0A0A</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">#111111</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">#FAFAFA</item>
        <item name="android:textColorSecondary">#888888</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">#0A0A0A</item>
        
        <!-- Enable edge-to-edge -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">false</item>
        
        <!-- Material Design 3 components -->
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
    </style>

    <!-- Card style -->
    <style name="Widget.App.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#1A1A1A</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Chip style -->
    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="chipStrokeColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- FAB style -->
    <style name="Widget.App.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">@android:color/white</item>
        <item name="rippleColor">@android:color/white</item>
    </style>

    <!-- Text appearances -->
    <style name="TextAppearance.App.Hero" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">48sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FAFAFA</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FAFAFA</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FAFAFA</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#888888</item>
    </style>

    <!-- Coming Soon style -->
	<style name="Theme.Talita.ComingSoon" parent="Theme.Talita">
    <!-- Coming soon specific styling -->
	</style>
	<style name="SwitchTheme" parent="Widget.MaterialComponents.CompoundButton.Switch">
    <item name="colorControlActivated">@color/primary</item>
    </style>

    <!-- Translucent theme for overlays -->
    <style name="Theme.Talita.Translucent" parent="Theme.Talita">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:backgroundDimEnabled">false</item>
</style>
</resources>
