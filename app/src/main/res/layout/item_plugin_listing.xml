<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FF2A2A2A"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Name and Category -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/plugin_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Plugin Name"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/plugin_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#9C27B0" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/plugin_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plugin description goes here"
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Bottom Row: Author, Rating, Downloads -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/plugin_author"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="by Author"
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/plugin_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.5 ⭐"
                android:textSize="12sp"
                android:textColor="#FFC107"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/plugin_downloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1K downloads"
                android:textSize="12sp"
                android:textColor="#888888" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
