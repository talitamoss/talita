<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select data to include:"
        android:textSize="16sp"
        android:textColor="#FAFAFA"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/include_location_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Include location data"
        android:textColor="#FAFAFA"
        android:checked="true"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/include_audio_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Include audio recordings"
        android:textColor="#FAFAFA"
        android:checked="true"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date range:"
        android:textSize="16sp"
        android:textColor="#FAFAFA"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/date_range_spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/rounded_rectangle"
        android:backgroundTint="#2A2A2A"
        android:padding="12dp"/>

</LinearLayout>
