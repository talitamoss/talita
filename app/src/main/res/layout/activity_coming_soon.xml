<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- Background gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_background"
        android:alpha="0.3"/>

    <!-- Back button -->
    <Button
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textColor="#888888"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="8dp"/>

    <!-- Lock icon -->
    <ImageView
        android:id="@+id/lock_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_lock"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="24dp"
        app:tint="#666666" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Feature Icon -->
        <ImageView
            android:id="@+id/feature_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_users"
            android:layout_marginBottom="24dp"
            app:tint="#6366F1" />

        <!-- Feature Title -->
        <TextView
            android:id="@+id/feature_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect"
            android:textSize="32sp"
            android:textColor="#FAFAFA"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Feature Description -->
        <TextView
            android:id="@+id/feature_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share without revealing"
            android:textSize="18sp"
            android:textColor="#888888"
            android:textStyle="italic"
            android:layout_marginBottom="32dp"/>

        <!-- Teaser Text -->
        <TextView
            android:id="@+id/teaser_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feature description goes here..."
            android:textSize="16sp"
            android:textColor="#AAAAAA"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="48dp"/>

        <!-- Notify Button -->
        <Button
            android:id="@+id/notify_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notify me when ready"
            android:textColor="#FAFAFA"
            android:backgroundTint="#6366F1"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"/>

    </LinearLayout>

    <!-- Coming Soon Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COMING SOON"
        android:textSize="12sp"
        android:textColor="#6366F1"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:background="@drawable/rounded_rectangle"
        android:backgroundTint="#1A1A2E"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
