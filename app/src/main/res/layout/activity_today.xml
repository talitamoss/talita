<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="56dp"> <!-- Space for bottom nav -->

        <!-- Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tracking_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="◉ Tracking Active"
                android:textSize="14sp"
                android:textColor="#6366F1"
                android:fontFamily="@font/jetbrains_mono"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to toggle"
                android:textSize="12sp"
                android:textColor="#666666"/>

        </LinearLayout>

        <!-- Today Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY"
                android:textSize="48sp"
                android:textColor="#FAFAFA"
                android:fontFamily="@font/sf_pro_display"
                android:letterSpacing="-0.02"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wednesday, July 23"
                android:textSize="16sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Data Visualization -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.core.talita.TodayActivity.DataVisualizationView
                android:id="@+id/data_visualization"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="24dp"/>

        </FrameLayout>

    </LinearLayout>

    <!-- Floating Action Buttons -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- FAB Overlay (for menu) -->
        <View
            android:id="@+id/fab_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:alpha="0"/>

        <!-- More Options FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="88dp"
            android:layout_marginBottom="88dp"
            android:src="@drawable/ic_more_horizontal"
            app:backgroundTint="#2A2A2A"
            app:tint="#FAFAFA"
            app:fabSize="mini"
            android:visibility="gone"/>

        <!-- Now View FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_now_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="88dp"
            android:layout_marginBottom="88dp"
            android:src="@drawable/ic_activity"
            app:backgroundTint="#2A2A2A"
            app:tint="#FAFAFA"
            app:fabSize="mini"
            android:visibility="gone"/>

        <!-- Main Quick Add FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_quick_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="88dp"
            android:src="@drawable/ic_add"
            app:backgroundTint="#6366F1"
            app:tint="#FAFAFA"
            app:fabSize="normal"/>

    </FrameLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#111111"
        app:menu="@menu/bottom_navigation"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
