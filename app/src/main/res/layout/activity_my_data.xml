<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="24sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MY DATA"
                android:textSize="24sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:layout_marginStart="16dp" />

            <ImageButton
                android:id="@+id/export_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_export"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Export data"
                app:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/search_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_search"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp"
                android:contentDescription="Search data"
                app:tint="#FFFFFFFF" />

        </LinearLayout>

        <!-- Time Period Selector -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_today"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Today"
                    android:textColor="#FFFFFFFF"
                    android:background="@drawable/button_outline"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_week"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Week"
                    android:textColor="#FFFFFFFF"
                    android:background="@drawable/button_primary"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_month"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Month"
                    android:textColor="#FFFFFFFF"
                    android:background="@drawable/button_outline"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_all"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="All Time"
                    android:textColor="#FFFFFFFF"
                    android:background="@drawable/button_outline"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Custom"
                    android:textColor="#FFFFFFFF"
                    android:background="@drawable/button_outline"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Life Score Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FF2A2A2A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯"
                            android:textSize="24sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/life_score_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Life Score: 87/100"
                            android:textSize="24sp"
                            android:textColor="#FF4CAF50"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/score_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↑ +5"
                            android:textSize="16sp"
                            android:textColor="#FF4CAF50" />

                    </LinearLayout>

                    <!-- Score Progress Bar -->
                    <ProgressBar
                        android:id="@+id/life_score_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="87"
                        android:max="100"
                        android:progressTint="#FF4CAF50"
                        android:progressBackgroundTint="#FF1A1A1A"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/life_score_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Top factors:\n• Sleep consistency ↑\n• Exercise frequency ↑\n• Water intake ↓"
                        android:textSize="14sp"
                        android:textColor="#FFCCCCCC"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Data Sovereignty Status -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FF2A2A2A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔐"
                            android:textSize="24sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sovereignty Status"
                            android:textSize="18sp"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/data_points_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2,847 data points"
                        android:textSize="16sp"
                        android:textColor="#FFFFFFFF"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/backup_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="744 pending backup"
                        android:textSize="14sp"
                        android:textColor="#FFFFC107"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/backup_now_button"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Backup Now"
                            android:textColor="#FFFFFFFF"
                            android:background="@drawable/button_primary"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/configure_button"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Configure"
                            android:textColor="#FFFFFFFF"
                            android:background="@drawable/button_outline" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Today's Quick Stats -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TODAY'S SNAPSHOT"
                android:textSize="14sp"
                android:textColor="#FF7B1FA2"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Steps -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#FF2A2A2A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/today_steps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8,432"
                            android:textSize="20sp"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="steps"
                            android:textSize="12sp"
                            android:textColor="#FFAAAAAA" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Water -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#FF2A2A2A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/today_water"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2.3L"
                            android:textSize="20sp"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="water"
                            android:textSize="12sp"
                            android:textColor="#FFAAAAAA" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Mood -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#FF2A2A2A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/today_mood"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😊"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="mood"
                            android:textSize="12sp"
                            android:textColor="#FFAAAAAA" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Sleep -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FF2A2A2A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/today_sleep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7.5h"
                            android:textSize="20sp"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="sleep"
                            android:textSize="12sp"
                            android:textColor="#FFAAAAAA" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Discovered Patterns -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DISCOVERED PATTERNS"
                android:textSize="14sp"
                android:textColor="#FF7B1FA2"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FF2A2A2A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="20sp"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/insights_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <Button
                        android:id="@+id/view_all_insights_button"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="View All Insights"
                        android:textColor="#FF7B1FA2"
                        android:background="?android:attr/selectableItemBackground"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Activity Chart -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTIVITY TRENDS"
                android:textSize="14sp"
                android:textColor="#FF7B1FA2"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/chart_card"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FF2A2A2A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/activity_chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp" />

            </androidx.cardview.widget.CardView>

            <!-- Domain Analysis Cards -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DETAILED ANALYSIS"
                android:textSize="14sp"
                android:textColor="#FF7B1FA2"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Movement & Location -->
            <androidx.cardview.widget.CardView
                android:id="@+id/movement_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FF2A2A2A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="24sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Movement Analysis"
                            android:textSize="18sp"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="#FF7B1FA2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total distance:"
                            android:textSize="14sp"
                            android:textColor="#FFAAAAAA" />

                        <TextView
                            android:id="@+id/total_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="47.3 km"
                            android:textSize="14sp"
                            android:textColor="#FFFFFFFF" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Unique places:"
                            android:textSize="14sp"
                            android:textColor="#FFAAAAAA" />

                        <TextView
                            android:id="@+id/unique_places"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:textSize="14sp"
                            android:textColor="#FFFFFFFF" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Most visited:"
                            android:textSize="14sp"
                            android:textColor="#FFAAAAAA" />

                        <TextView
                            android:id="@+id/most_visited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Home (168h)"
                            android:textSize="14sp"
                            android:textColor="#FFFFFFFF" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Health & Wellness -->
            <androidx.cardview.widget.CardView
                android:id="@+id/wellness_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FF2A2A2A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💪"
                            android:textSize="24sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Wellness Trends"
                            android:textSize="18sp"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="#FF7B1FA2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Average sleep:"
                            android:textSize="14sp"
                            android:textColor="#FFAAAAAA" />

                        <TextView
                            android:id="@+id/avg_sleep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7.2h ↑0.3h"
                            android:textSize="14sp"
                            android:textColor="#FFFFFFFF" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Exercise days:"
                            android:textSize="14sp"
                            android:textColor="#FFAAAAAA" />

                        <TextView
                            android:id="@+id/exercise_days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5/7 ↑2"
                            android:textSize="14sp"
                            android:textColor="#FFFFFFFF" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mood trend:"
                            android:textSize="14sp"
                            android:textColor="#FFAAAAAA" />

                        <TextView
                            android:id="@+id/mood_trend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Improving ↗"
                            android:textSize="14sp"
                            android:textColor="#FF4CAF50" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Audio Memories -->
            <androidx.cardview.widget.CardView
                android:id="@+id/audio_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="80dp"
                app:cardBackgroundColor="#FF2A2A2A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎙️"
                            android:textSize="24sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Voice Notes"
                            android:textSize="18sp"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="#FF7B1FA2" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/audio_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
