<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collector_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#FF2A2A2A"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/collector_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧"
            android:textSize="24sp"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/collector_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Water Intake"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/collector_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active and collecting data"
                android:textSize="14sp"
                android:textColor="#4CAF50"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/info_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="ℹ"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:textColor="#888888"
            android:layout_marginEnd="8dp" />

        <Switch
            android:id="@+id/collector_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</androidx.cardview.widget.CardView>