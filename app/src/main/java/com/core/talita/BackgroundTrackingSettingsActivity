package com.core.talita;

import android.content.Intent;
import android.content.SharedPreferences;
import android.os.Bundle;
import android.util.Log;
import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;
import android.widget.Button;
import android.widget.Switch;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;
import androidx.cardview.widget.CardView;
import androidx.recyclerview.widget.LinearLayoutManager;
import androidx.recyclerview.widget.RecyclerView;

import java.util.ArrayList;
import java.util.List;

/**
 * Background Tracking Settings Activity
 * Manages individual tracking services with toggle controls
 */
public class BackgroundTrackingSettingsActivity extends AppCompatActivity {
    
    private static final String TAG = "BackgroundTrackingSettings";
    
    private RecyclerView trackingServicesRecycler;
    private TrackingServicesAdapter adapter;
    private TrackingManager trackingManager;
    private SharedPreferences trackingPrefs;
    
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_background_tracking_settings);
        
        try {
            trackingManager = new TrackingManager(this);
            trackingPrefs = getSharedPreferences("background_tracking_services", MODE_PRIVATE);
            
            initializeViews();
            setupTrackingServices();
            
            Log.d(TAG, "🎯 Background Tracking Settings initialized");
            
        } catch (Exception e) {
            Log.e(TAG, "❌ Error initializing Background Tracking Settings: " + e.getMessage());
            Toast.makeText(this, "Error loading tracking settings", Toast.LENGTH_SHORT).show();
        }
    }
    
    private void initializeViews() {
        // Back button
        Button backButton = findViewById(R.id.back_button);
        backButton.setOnClickListener(v -> finish());
        
        // RecyclerView for tracking services
        trackingServicesRecycler = findViewById(R.id.tracking_services_recycler);
        trackingServicesRecycler.setLayoutManager(new LinearLayoutManager(this));
    }
    
    private void setupTrackingServices() {
        List<TrackingServiceItem> services = createTrackingServices();
        
        adapter = new TrackingServicesAdapter(services, this::onServiceToggled);
        trackingServicesRecycler.setAdapter(adapter);
    }
    
    private List<TrackingServiceItem> createTrackingServices() {
        List<TrackingServiceItem> services = new ArrayList<>();
        
        // Location Tracking Service
        boolean locationEnabled = trackingPrefs.getBoolean("location_tracking", false);
        services.add(new TrackingServiceItem(
                "location_tracking",
                "📍",
                "Location Tracking",
                "Continuous GPS location recording with activity context",
                locationEnabled,
                true // Available
        ));
        
        // Future services (commented out for now)
        /*
        services.add(new TrackingServiceItem(
                "step_tracking",
                "👣",
                "Step Counter", 
                "Daily step counting and activity recognition",
                false,
                true
        ));
        
        services.add(new TrackingServiceItem(
                "wifi_tracking",
                "📶",
                "WiFi Networks",
                "Track visited WiFi networks for location context",
                false,
                true
        ));
        */
        
        return services;
    }
    
    private void onServiceToggled(TrackingServiceItem service, boolean enabled) {
        Log.d(TAG, "🔄 Service toggled: " + service.name + " = " + enabled);
        
        // Save the preference
        trackingPrefs.edit()
                .putBoolean(service.id, enabled)
                .apply();
        
        // Handle specific service logic
        switch (service.id) {
            case "location_tracking":
                handleLocationTrackingToggle(enabled);
                break;
            default:
                Toast.makeText(this, service.name + " " + (enabled ? "enabled" : "disabled"), 
                        Toast.LENGTH_SHORT).show();
        }
    }
    
    private void handleLocationTrackingToggle(boolean enabled) {
        if (enabled) {
            // Start location tracking
            boolean success = trackingManager.startTracking();
            if (success) {
                Toast.makeText(this, "📍 Location tracking started", Toast.LENGTH_SHORT).show();
            } else {
                // Failed - revert the toggle
                trackingPrefs.edit().putBoolean("location_tracking", false).apply();
                adapter.updateServiceState("location_tracking", false);
                Toast.makeText(this, "❌ Failed to start location tracking", Toast.LENGTH_LONG).show();
            }
        } else {
            // Stop location tracking
            boolean success = trackingManager.stopTracking();
            if (success) {
                Toast.makeText(this, "⏹️ Location tracking stopped", Toast.LENGTH_SHORT).show();
            }
        }
    }
    
    @Override
    protected void onResume() {
        super.onResume();
        // Refresh service states when returning to this screen
        if (adapter != null) {
            updateServiceStates();
        }
    }
    
    private void updateServiceStates() {
        // Update location tracking state
        boolean actualLocationState = trackingManager.isTrackingEnabled();
        boolean savedLocationState = trackingPrefs.getBoolean("location_tracking", false);
        
        // Sync states if they're out of sync
        if (actualLocationState != savedLocationState) {
            trackingPrefs.edit().putBoolean("location_tracking", actualLocationState).apply();
            adapter.updateServiceState("location_tracking", actualLocationState);
        }
    }
    
    /**
     * Data class for tracking service items
     */
    public static class TrackingServiceItem {
        public final String id;
        public final String icon;
        public final String name;
        public final String description;
        public boolean enabled;
        public final boolean available;
        
        public TrackingServiceItem(String id, String icon, String name, String description, 
                                   boolean enabled, boolean available) {
            this.id = id;
            this.icon = icon;
            this.name = name;
            this.description = description;
            this.enabled = enabled;
            this.available = available;
        }
    }
    
    /**
     * Adapter for tracking services list
     */
    public static class TrackingServicesAdapter extends RecyclerView.Adapter<TrackingServicesAdapter.ServiceViewHolder> {
        
        public interface ServiceToggleListener {
            void onServiceToggled(TrackingServiceItem service, boolean enabled);
        }
        
        private final List<TrackingServiceItem> services;
        private final ServiceToggleListener listener;
        
        public TrackingServicesAdapter(List<TrackingServiceItem> services, ServiceToggleListener listener) {
            this.services = services;
            this.listener = listener;
        }
        
        @Override
        public ServiceViewHolder onCreateViewHolder(ViewGroup parent, int viewType) {
            View view = LayoutInflater.from(parent.getContext())
                    .inflate(R.layout.item_tracking_service, parent, false);
            return new ServiceViewHolder(view);
        }
        
        @Override
        public void onBindViewHolder(ServiceViewHolder holder, int position) {
            TrackingServiceItem service = services.get(position);
            holder.bind(service, listener);
        }
        
        @Override
        public int getItemCount() {
            return services.size();
        }
        
        public void updateServiceState(String serviceId, boolean enabled) {
            for (int i = 0; i < services.size(); i++) {
                TrackingServiceItem service = services.get(i);
                if (service.id.equals(serviceId)) {
                    service.enabled = enabled;
                    notifyItemChanged(i);
                    break;
                }
            }
        }
        
        static class ServiceViewHolder extends RecyclerView.ViewHolder {
            private final TextView iconText;
            private final TextView nameText;
            private final TextView descriptionText;
            private final Switch toggleSwitch;
            private final CardView cardView;
            
            ServiceViewHolder(View itemView) {
                super(itemView);
                iconText = itemView.findViewById(R.id.service_icon);
                nameText = itemView.findViewById(R.id.service_name);
                descriptionText = itemView.findViewById(R.id.service_description);
                toggleSwitch = itemView.findViewById(R.id.service_toggle);
                cardView = itemView.findViewById(R.id.service_card);
            }
            
            void bind(TrackingServiceItem service, ServiceToggleListener listener) {
                iconText.setText(service.icon);
                nameText.setText(service.name);
                descriptionText.setText(service.description);
                toggleSwitch.setChecked(service.enabled);
                
                // Enable/disable based on availability
                toggleSwitch.setEnabled(service.available);
                cardView.setAlpha(service.available ? 1.0f : 0.5f);
                
                // Set toggle listener
                toggleSwitch.setOnCheckedChangeListener((buttonView, isChecked) -> {
                    if (listener != null && service.available) {
                        listener.onServiceToggled(service, isChecked);
                    }
                });
                
                // Style the card
                cardView.setCardBackgroundColor(service.enabled ? 0xFF2E7D32 : 0xFF2A2A2A);
            }
        }
    }
}
